// Sea passage rules (V2, D-016). Placeholder values tuned so a 560-league crossing takes about three
// weeks with a crew that keeps the ship up, and goes badly for one that does not.
{
  // Bilge rise per hour with a sound hull (percent of what she can hold before foundering).
  "baseLeakPerHour": 1.2,
  // Extra bilge rise per hour for each hull point lost below 100.
  "leakPerHullPointLost": 0.1,
  // Speed left with the rigging in tatters; full speed at 100.
  "riggingSpeedFloor": 0.35,
  // Nobody at the helm or on lookout: she yaws about and the sails are not trimmed.
  "noWatchSpeedMultiplier": 0.4,
  "bilgeAlarms": [50, 80],
