// The shore where the expedition lands (docs/R6_LANDFALL_CAMP.md; SETTLEMENT_EXPERIENCE §3-6; SETTING §5).
// Each site is what is there to be found; the camp knows only what is "known" on landing, and scouting finds
// the rest in turn (water first, then food, then the rest). A "hint" is what is seen or guessed before it is
// found. "default" is any landing not listed.
{
  "rules": {
    // Shelter: berths each completed work gives, by kind.
    "sailBerths": 4,
    "brushBerths": 3,
    "sickBerths": 3,
    // A wet night in the open: fatigue and stress an hour, and the chance of a chill (fever) an hour.
    "exposedFatiguePerHour": 3,
    "exposedStressPerHour": 2,
    "chillPerWetHour": 0.012,
    // A fire burning halves the chill and eases the night.
    "fireHours": 6,
    // Uncovered stores in the rain: the share of each food lost an hour.
    "spoilPerRainHour": 0.01,
    // What the boat brings ashore each trip, kg; and the sea it cannot pass (rain squalls make the surf).
    "boatTripKg": 160,
    "swimTripKg": 30,
    // The camp grows foul by this much a day without a latrine (and with one, comes back).
    "foulPerDay": 4,
    "cleanPerDay": 2,
    // Scouting: the chance each trip finds the next thing, plus this for each level of the scout's tracking or foraging.
    "scoutChance": 0.6,
    "scoutChancePerSkill": 0.1,
    // The first days' report, this many hours after landing.
    "reportHours": 72
  },
  // Making the camp last, the first season (R7, docs/R7_ESTABLISHMENT.md). Each building is raised in
  // phases, each phase a task done so many times where it is placed; its quality is the work's. Width and
  // depth are its footprint in cells (metres), before it is turned.
  "settlement": {
    "buildings": [
      { "id": "building.hut", "width": 4, "depth": 3, "name": "Hut", "plot": "hut", "berths": 4,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 3 } ] },
      { "id": "building.storehouse", "width": 5, "depth": 4, "name": "Storehouse", "plot": "store", "stores": true,
        "phases": [ { "task": "task.clear_ground", "times": 2 }, { "task": "task.set_posts", "times": 3 }, { "task": "task.raise_frame", "times": 3 }, { "task": "task.thatch_roof", "times": 3 }, { "task": "task.fit_out", "times": 2 } ] },
      { "id": "building.cookhouse", "width": 4, "depth": 4, "name": "Cookhouse", "plot": "cook", "cooks": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 1 }, { "task": "task.thatch_roof", "times": 2 } ] },
      { "id": "building.infirmary", "width": 5, "depth": 4, "name": "Infirmary", "plot": "infirmary", "sickBerths": 6,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 3 } ] },
      { "id": "building.workshop", "width": 4, "depth": 4, "name": "Workshop", "plot": "workshop", "mends": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 2 } ] },
      // A house: a household's own home, raised a little better than a hut and fitted out. Berths for four;
      // a household without one wants one (step P, docs/STRUCTURES.md).
      { "id": "building.house", "width": 5, "depth": 4, "name": "House", "plot": "house", "berths": 4, "home": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 3 }, { "task": "task.thatch_roof", "times": 3 }, { "task": "task.fit_out", "times": 1 } ] },
      // A smokehouse: racks over a slow fire under a low roof, where fresh fish is smoked to keep for months.
      { "id": "building.smokehouse", "width": 3, "depth": 3, "name": "Smokehouse", "plot": "smokehouse", "smokes": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 1 }, { "task": "task.raise_frame", "times": 1 }, { "task": "task.thatch_roof", "times": 1 } ] },
      // A chapel: a cross, an altar and a roof. Sunday is kept there: the company rests easier for it.
      { "id": "building.chapel", "width": 4, "depth": 5, "name": "Chapel", "plot": "chapel", "chapel": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 2 }, { "task": "task.fit_out", "times": 1 } ] },
      // A trading house: a roofed place to receive a people's delegations and lay out the goods. They come
      // more often, and a fair trade there counts for more.
      { "id": "building.trading_house", "width": 5, "depth": 4, "name": "Trading house", "plot": "trading", "trades": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 2 } ] },
      // Salt pans, as Kessat makes them: clay-lined pans and a boiling shed. Only once it is learned how.
      { "id": "building.salt_pans", "width": 5, "depth": 3, "name": "Salt pans", "plot": "salt", "salts": true, "knowledge": "know.salt",
        "phases": [ { "task": "task.clear_ground", "times": 2 }, { "task": "task.set_posts", "times": 1 }, { "task": "task.thatch_roof", "times": 1 } ] },
      // A forge: a hearth, bellows, an anvil on a stump. Bar iron made into the tools the camp is shortest of.
      { "id": "building.forge", "width": 4, "depth": 4, "name": "Forge", "plot": "forge", "forges": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 1 }, { "task": "task.thatch_roof", "times": 2 } ] },
      // Step S (docs/THE_SHIP.md): what the ship and her guns want ashore.
      // A lookout on the high ground: a sail seen a day sooner.
      { "id": "building.lookout", "width": 2, "depth": 2, "name": "Lookout", "plot": "lookout", "lookout": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 1 } ] },
      // A boat shed and slip: the boat kept out of the weather, and a hard where the ship is hove down and her
      // hull cleaned and mended.
      { "id": "building.boat_shed", "width": 5, "depth": 4, "name": "Boat shed and slip", "plot": "slip", "slip": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.raise_frame", "times": 2 }, { "task": "task.thatch_roof", "times": 2 } ] },
      // A powder magazine: dug in, roofed, apart from every fire. Powder keeps dry there.
      { "id": "building.magazine", "width": 3, "depth": 3, "name": "Powder magazine", "plot": "magazine", "magazine": true,
        "phases": [ { "task": "task.clear_ground", "times": 2 }, { "task": "task.set_posts", "times": 1 }, { "task": "task.thatch_roof", "times": 2 }, { "task": "task.fit_out", "times": 1 } ] },
      // A gun platform: a timber bed and an earth bank for two guns landed from the ship, covering the anchorage.
      { "id": "building.battery", "width": 4, "depth": 3, "name": "Gun platform", "plot": "battery", "battery": 2,
        "phases": [ { "task": "task.clear_ground", "times": 2 }, { "task": "task.set_posts", "times": 2 }, { "task": "task.fit_out", "times": 1 } ] },
      // A well: only where the site has water to be dug for (a site's "well"). It brings the water to the camp,
      // but a latrine within six cells fouls it. Lined with wattle and poles against the sand falling in.
      { "id": "building.well", "width": 2, "depth": 2, "name": "Well", "plot": "well", "water": true,
        "phases": [ { "task": "task.clear_ground", "times": 1 }, { "task": "task.dig_well", "times": 4 }, { "task": "task.line_well", "times": 2 } ] },
      // A landing: a hard of stones laid down the wet sand, and a timber staging, by the boat. The boat lands
      // half as much again each trip. Set down at the water's edge; it is walked over, not round.
      { "id": "building.landing", "width": 4, "depth": 3, "name": "Landing", "plot": "landing", "landing": true,
        "phases": [ { "task": "task.lay_stones", "times": 3 }, { "task": "task.build_staging", "times": 2 } ] },
      { "id": "building.garden", "width": 8, "depth": 5, "name": "Garden", "plot": "garden", "beds": 6,
        "phases": [ { "task": "task.clear_ground", "times": 3 }, { "task": "task.dig_beds", "times": 3 }, { "task": "task.fence_garden", "times": 2 } ] }
    ],
    // [RESEARCH] What a garden of European seed might make of a wet tropical shore: to be checked. Suitability
    // is how well it takes (the daily wasting it suffers is 1 - that); wetRot more in the wet season.
    "crops": [
      { "id": "crop.wheat", "name": "wheat", "seed": "item.seed_wheat", "yields": "item.wheat", "perBed": 30, "growDays": 100, "suitability": 0.25, "wetRot": 0.03, "drySowingOnly": true },
      { "id": "crop.chickpea", "name": "chickpeas", "seed": "item.seed_chickpea", "yields": "item.chickpeas", "perBed": 25, "growDays": 85, "suitability": 0.45, "wetRot": 0.025, "drySowingOnly": true },
      { "id": "crop.onion", "name": "onions", "seed": "item.seed_onion", "yields": "item.onions", "perBed": 40, "growDays": 60, "suitability": 0.7, "wetRot": 0.008 },
      // The coast's own (R8): grown only once its people have shown how, from cuttings and seed they give.
      { "id": "crop.cassava", "name": "cassava", "seed": "item.cassava_cuttings", "yields": "item.cassava_root", "perBed": 60, "growDays": 100, "suitability": 0.95, "wetRot": 0.002, "knowledge": "know.roots" },
      { "id": "crop.maize", "name": "maize", "seed": "item.seed_maize", "yields": "item.maize", "perBed": 40, "growDays": 75, "suitability": 0.88, "wetRot": 0.004, "knowledge": "know.roots" },
      { "id": "crop.cabbage", "name": "cabbages and greens", "seed": "item.seed_cabbage", "yields": "item.greens", "perBed": 50, "growDays": 45, "suitability": 0.6, "wetRot": 0.008 }
    ],
    // What the forest's edge gives before it must be gone further for (and the work it then takes).
    "poles": 140,
    "thatch": 260,
    // Loads of stone to be had from the point's rocks, where the site has rock.
    "stone": 90,
    "scarce": 0.2,
    // The first wet season: it comes this many days after landing, rain this many times as often.
    "wetFromDay": 20,
    // The wet season's length, and the year: it comes again each year (step P).
    "wetDays": 170, "yearDays": 365,
    "wetRain": 4,
    // The storm at the change of season.
    "stormDay": 30,
    "stormHours": 30,
    // The first season, judged.
    "judgeDay": 90,
    // Tools: the chance an hour of use that one breaks; the chance mending saves it.
    "toolBreaksPerHour": 0.002,
    "mendChance": 0.8,
    // The ground: paths worn only by feet (a cell walked over this many times shows, this many is bare),
    // fading back when left alone; and what was felled or cleared growing back when no one touches it:
    // scrub, brush, a sapling, a tree again. [RESEARCH] Pioneer growth on a wet tropical shore is fast;
    // the days are a game's reading of it.
    "ground": {
      "pathFaint": 40, "pathFull": 400, "pathWear": 0.04, "pathUntrod": 0.12, "pathUntrodDays": 5,
      "scrubDays": 8, "brushDays": 20, "saplingDays": 40, "treeDays": 75,
      "thatchRegrowAfterDays": 10, "thatchRegrowPerDay": 3
    }
  },
  "sites": [
    {
      // The headland above the beach at Punta Ceniza, where the Company's factory stood (step 2, the move):
      // the charter's own ground. The spring is close below, the breeze keeps the fever down, the ruin
      // gives its timbers, and a palisade across the neck closes it; but it is Oruwai's fishing households'.
      "id": "coast.ceniza_headland", "ground": "headland",
      "name": "the headland at Punta Ceniza",
      "rain": 0.08,
      "fever": 0.002,
      "brush": true,
      "seen": [
        "The headland's top: the burned factory's posts, the ditch of its palisade, and the sea on three sides.",
        "Below, the spring the factory drew from, and the path down to the beach."
      ],
      "water": [
        { "id": "water.factory_spring", "name": "the factory's spring", "kind": "spring", "perHour": 40, "walk": 4, "known": true,
          "hint": "The spring is just below the headland's brow." }
      ],
      "food": [
        { "id": "food.reef_fish", "name": "fish off the point", "item": "item.fish", "perHour": 3,
          "hint": "Fish jump in the swell off the point." },
        { "id": "food.lagoon_shellfish", "name": "shellfish on the lagoon's edge", "item": "item.shellfish", "perHour": 4, "unfamiliar": true,
          "hint": "Gulls working the lagoon's edge at low water, a walk below." }
      ],
      "finds": [
        { "id": "find.factory", "kind": "ruin", "name": "the burned factory",
          "text": "The factory is burned to the ground. The palisade is down, the storehouse a ring of black posts, and there is no sign of the garrison.",
          "planks": 30, "known": true, "hint": "The factory, burned." }
      ]
    },
    {
      "id": "coast.punta_ceniza", "ground": "headland",
      "name": "Punta Ceniza",
      "rain": 0.08,
      "fever": 0.004,
      "brush": true,
      "seen": [
        "A rocky headland, a beach of shell and coarse sand under it, and behind it the still water of a lagoon.",
