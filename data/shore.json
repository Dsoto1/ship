      ],
      "water": [
        { "id": "water.factory_spring", "name": "the factory's spring", "kind": "spring", "perHour": 40, "walk": 14, "known": true,
          "hint": "The sailing directions put a spring under the headland, that the factory drew from." }
      ],
      "food": [
        { "id": "food.lagoon_shellfish", "name": "shellfish on the lagoon's edge", "item": "item.shellfish", "perHour": 6, "unfamiliar": true,
          "hint": "Gulls working the lagoon's edge at low water." },
        { "id": "food.reef_fish", "name": "fish off the point", "item": "item.fish", "perHour": 3,
          "hint": "Fish jump in the swell off the point." }
      ],
      "finds": [
        { "id": "find.factory", "kind": "ruin", "name": "the burned factory",
