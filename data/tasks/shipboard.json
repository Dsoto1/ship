// Shipboard tasks for the first voyage. needsPerHour is added on top of the baseline.
// Item IDs are not yet validated; item definitions arrive in Ticket 3.
[
  {
    "id": "task.rest",
    "name": "Rest",
    "durationMinutes": 240,
    "isRest": true,
    "needsPerHour": { "fatigue": -9.0 }
  },
  {
    "id": "task.stand_watch",
    "needsWorkSpot": true,
    "name": "Stand watch",
    "durationMinutes": 240,
    // Someone at the helm and on lookout: without them she makes little headway.
    "keepsWatch": true,
    // A watch kept in a seaway shows who knows the work: the captain sees it, whatever was said ashore.
    "shows": ["skill.seamanship", "skill.sailing"],
    "needsPerHour": { "fatigue": 1.0, "stress": 0.25 }
  },
  {
    "id": "task.pump_bilge",
    "needsWorkSpot": true,
    "attribute": "attribute.strength",
    "name": "Pump the bilge",
    "durationMinutes": 60,
    // About 18 points of bilge an hour at normal effort; strong backs pump faster.
    "shipPerHour": { "bilge": -18 },
    "dutyWhen": { "bilgeAbove": 15 },
    "needsPerHour": { "fatigue": 6.0, "thirst": 1.0 }
  },
  {
    "id": "task.repair_rigging",
    "needsWorkSpot": true,
    "name": "Repair rigging",
    "durationMinutes": 120,
    "shipOnComplete": { "rigging": 12 },
    "dutyWhen": { "riggingBelow": 75 },
    "skill": "skill.rigging",
    "attribute": "attribute.coordination",
    "minSkill": 1,
    "requiredTools": ["item.marlinspike"],
    "consumes": { "item.rope": 1 },
    "needsPerHour": { "fatigue": 4.0 },
    "hazard": { "chancePerHour": 0.02, "healthDamage": 20, "condition": "condition.rope_burn" }
  },
  {
    "id": "task.patch_hull",
    "needsWorkSpot": true,
    "name": "Patch the hull",
    "durationMinutes": 180,
    "shipOnComplete": { "hull": 15 },
    "dutyWhen": { "hullBelow": 75 },
    "skill": "skill.ship_repair",
    "minSkill": 1,
    "requiredTools": ["item.caulking_mallet"],
    "consumes": { "item.oakum": 2, "item.plank": 1 },
    "needsPerHour": { "fatigue": 5.0, "stress": 0.5 }
  },
  {
    "id": "task.cook",
    "needsWorkSpot": true,
    "name": "Cook for the crew",
    "durationMinutes": 90,
    // A hot meal at midday and in the evening eases everyone's stress.
    "crewOnComplete": { "stress": -6 },
    "dutyWhen": { "startBetween": [[10, 11], [17, 18]] },
    "skill": "skill.cooking",
    "needsPerHour": { "fatigue": 2.0 }
  },
  {
    "id": "task.catch_rain",
    "name": "Catch the rain",
    "durationMinutes": 120,
    // The courses slacked off and their feet led into the casks, the awnings spread over the scuttles:
    // a squall gives a cask in an hour or two. Only while it rains, and only with casks to fill.
    "needsWeather": { "rain": true },
    "yield": { "item": "item.water", "perHour": 14 },
    "needsPerHour": { "fatigue": 2.5 }
  },
  {
    "id": "task.fish",
    "name": "Fish over the side",
    "durationMinutes": 180,
    // Lines over the side: fresh food, more for a fisherman, more over the bank, nothing in a gale.
    // An easy hour at it eases the mind.
    "skill": "skill.fishing",
    "needsWeather": { "seaStateBelow": 1.6 },
    "yield": { "item": "item.fish", "perHour": 2.2, "bestInCalm": true, "onTheBank": 2.5 },
    "needsPerHour": { "fatigue": 1.0, "stress": -0.5 }
  },
  {
    "id": "task.water_ashore",
    "name": "Water the ship ashore",
    "durationMinutes": 240,
    // At anchor off an island: the boat in through the surf with the empty casks, filled at the spring,
    // rafted off. Far more than rain gives, as good as the spring is; the surf can roll a boat.
    "attribute": "attribute.strength",
    "needsWeather": { "atAnchor": true },
    "yield": { "item": "item.water", "perHour": 45, "ashore": "spring" },
    "needsPerHour": { "fatigue": 6.0, "thirst": 1.0 },
    "hazard": { "chancePerHour": 0.01, "healthDamage": 12, "condition": "condition.bruised" }
  },
  {
    "id": "task.forage_ashore",
    "name": "Forage ashore",
    "durationMinutes": 240,
    // Fruit, greens, birds' eggs: as much as the island has.
    "skill": "skill.foraging",
    "needsWeather": { "atAnchor": true },
    "yield": { "item": "item.fruit", "perHour": 5, "ashore": "forage" },
    "needsPerHour": { "fatigue": 3.0, "stress": -0.8 }
  }
]
