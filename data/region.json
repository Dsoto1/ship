// The Ember Coast around the great lagoon (R8, docs/R8_THE_WORLD_AROUND.md; SETTLEMENT_EXPERIENCE §26-35;
// SETTING §3, §5). Positions are in leagues, east (x) and north (y) of Punta Ceniza. Everything here exists
// whether or not the expedition has found it: "known" is what the Company's sailing directions give on
// landing (seen or reported); the rest is found by going there or by being told.
// [RESEARCH] The peoples are invented for a fictional coast; to be checked in the plausibility pass.
{
  "places": [
    { "id": "place.punta_ceniza", "name": "Punta Ceniza", "kind": "headland", "x": 0, "y": 0, "site": "coast.punta_ceniza", "known": "seen",
      "text": "The headland, and on it the burned factory: posts like black teeth, the palisade down, the spring below.",
      "report": "The Company's factory, on the headland, by the spring.", "ground": "people.oruwai" },
    { "id": "place.lagoon_shore", "name": "the lagoon shore", "kind": "shore", "x": 1.5, "y": 1,
      "text": "The seaward shore of the great lagoon: fish weirs of stakes and woven cane across the channels, kept in good repair.",
      "report": "Fish weirs along the lagoon's shore.", "ground": "people.mahenu" },
    { "id": "place.mahenu", "name": "Mahenu", "kind": "village", "x": 4, "y": 1.5, "people": "people.mahenu", "known": "reported",
      "text": "Mahenu: long houses of poles and thatch in a ring about a cleared ground, canoes drawn up below, gardens of roots and grain going back into the forest.",
      "report": "A village on the lagoon's east shore, that traded with the factory." },
    { "id": "place.fishing_camp", "name": "Oruwai's fishing camp", "kind": "camp", "x": 1, "y": 3,
      "text": "A fishing camp on a sandbar at the lagoon's mouth: drying racks, the frames of shelters, and the black marks of a fire on the sand, old now. No one camps here.",
      "report": "A fishing camp at the lagoon's mouth, left empty.", "ground": "people.oruwai" },
    { "id": "place.oruwai", "name": "Oruwai", "kind": "village", "x": 2.5, "y": 5, "people": "people.oruwai",
      "text": "Oruwai: a ring of long houses on a rise at the lagoon's north end, with a fence of stakes about it, and the dye-wood forest dark behind.",
      "report": "A second village, at the north of the lagoon, by the dye-wood." },
    { "id": "place.dyewood", "name": "the dye-wood stands", "kind": "forest", "x": 4, "y": 6.5, "wood": true,
      "text": "Embrawood, the red dye-wood, in stands among the forest, the big trees ringed with cut marks of many seasons, each household's trees known to it.",
      "report": "The red wood grows inland of the lagoon's north end.", "ground": "people.oruwai" },
    { "id": "place.river_mouth", "name": "the Río Bermejo mouth", "kind": "river", "x": -3, "y": 6, "site": "coast.rio_bermejo", "known": "reported",
      "text": "The Río Bermejo comes down red-brown over the bar, wide and slow, the forest to the water on both banks.",
      "report": "A great river, a day and a half north along the shore." },
    { "id": "place.tesiwa_landing", "name": "the canoe landing", "kind": "landing", "x": -1, "y": 10,
      "text": "Up the river, a landing of beaten earth where big dugouts are drawn up, a lean-to for traders, and the path inland.",
      "report": "A landing up the river, where the river people come down to trade.", "ground": "people.tesiwa" },
    { "id": "place.kessat", "name": "Kessat", "kind": "town", "x": 0, "y": 13, "people": "people.tesiwa",
      "text": "Kessat: houses close together on terraces above the river, smoke from the salt-boilers, and above it all the hill.",
      "report": "The river people's town, in the valley above the falls.", "ground": "people.tesiwa" },
    { "id": "place.hill", "name": "the hill", "kind": "sacred", "x": 2, "y": 14.5, "sacred": true,
      "text": "A green hill above Kessat, its top bare, a path to it marked with posts. No one goes up it but those whose right it is.",
      "report": "A hill above the river people's town that is not to be climbed.", "ground": "people.tesiwa" },
    { "id": "place.salt_pans", "name": "the salt pans", "kind": "shore", "x": -4, "y": 9,
      "text": "Salt pans behind the dunes north of the river, worked in the dry season by the river people.",
      "report": "Salt pans north of the river.", "ground": "people.tesiwa" },
    { "id": "place.brennish_cove", "name": "the Brennish cove", "kind": "cove", "x": -6, "y": 11,
      "text": "A deep cove behind a spit, out of sight of the open sea, with the ashes of fires, broken casks, and a cross cut in a tree in the Brennish way.",
      "report": "A cove where the Brennish ships put in." },
    { "id": "place.bajos_largos", "name": "the Bajos Largos", "kind": "shore", "x": -8, "y": 3, "site": "coast.bajos_largos",
      "text": "Long grey shoals and sand spits, without a tree.", "report": "Long shoals to the north-west." },
    { "id": "place.punta_falsa", "name": "Punta Falsa", "kind": "headland", "x": 6, "y": -6, "site": "coast.punta_falsa",
      "text": "A false point of broken rock, a cove of coral sand.", "report": "A point to the south, that looks like Punta Ceniza from the sea." },
    { "id": "place.manglares", "name": "the Manglares", "kind": "swamp", "x": 9, "y": -2, "site": "coast.manglares",
      "text": "Mangroves in black mud, the lagoon's far end bleeding into them.", "report": "Mangrove swamps beyond the lagoon." }
  ],
