  // The peoples (SETTING §5). Values are what a thing is worth to them, in their own reckoning; "offers" is
  // what they will part with and what it costs them. Temperament: how readily they trade, how cautious they
  // are of strangers. They act on their own each day by these and by how the newcomers have dealt with them.
  "communities": [
    {
      "id": "people.mahenu", "name": "Mahenu", "people": "the Ahuneri", "place": "place.mahenu", "language": "language.ahuneri",
      "trust": 8, "trade": 0.8, "caution": 0.35, "giftCulture": true, "firstVisitDay": 3, "visitEveryDays": 6,
      "about": "Mahenu traded logs and food to the old factory for iron. Its council is for renewed trade, on its own terms; it has not forgotten the ship that took people from a fishing camp.",
      "persons": [
        { "id": "person.narehwa", "name": "Narehwa", "role": "speaker of Mahenu's council", "about": "Grey, unhurried, and listens longer than she speaks. She carries the council's word and will not say what it has not agreed." },
        { "id": "person.ahiro", "name": "Ahiro", "role": "a young man of Mahenu", "about": "Fourteen or so, quick, with a castaway's grey eyes. Ximena's son." }
      ],
      "wants": { "item.axe": 12, "item.cutlass": 10, "item.trade_knives": 6, "item.trade_cloth": 8, "item.fishhooks": 1.5, "item.sailcloth": 6 },
      "offers": { "item.cassava_bread": 1, "item.maize": 1, "item.smoked_fish": 1.5, "item.fruit": 0.7, "item.embrawood": 4, "item.cassava_cuttings": 2, "item.seed_maize": 2 }
    },
    {
      "id": "people.oruwai", "name": "Oruwai", "people": "the Ahuneri", "place": "place.oruwai", "language": "language.ahuneri",
      "trust": -6, "trade": 0.55, "caution": 0.75, "giftCulture": true, "firstVisitDay": 12, "visitEveryDays": 10,
      "about": "Oruwai holds the dye-wood and the fishing grounds at the lagoon's mouth. Its council would keep the newcomers weak and at a distance, and has reason to.",
      "persons": [
        { "id": "person.hiruwe", "name": "Hiruwe", "role": "speaker of Oruwai's council", "about": "Lean and watchful. He looks at the camp's tools before he looks at the people holding them." },
        { "id": "person.wenari", "name": "Wenari", "role": "a canoe-builder of Oruwai", "about": "Broad-handed and cheerful; trades whatever the council allows and asks about every tool he sees." }
      ],
      "wants": { "item.axe": 14, "item.cutlass": 10, "item.trade_knives": 7, "item.trade_cloth": 6, "item.fishhooks": 1.5 },
      "offers": { "item.embrawood": 3, "item.smoked_fish": 1.5, "item.cassava_bread": 1.2 }
    },
    {
      "id": "people.tesiwa", "name": "Kessat", "people": "the Tesiwa", "place": "place.kessat", "language": "language.tesiwa",
      "trust": 0, "trade": 0.7, "caution": 0.5, "giftCulture": false, "firstVisitDay": 20, "visitEveryDays": 12,
      "about": "The river people of Kessat hold the river route inland. They resent the lagoon villages' hold on the foreigners' trade, and they have been trading with the Brennish.",
      "persons": [
        { "id": "person.sattek", "name": "Sattek", "role": "war captain of Kessat for the season", "about": "Tall, scarred along one arm, and proud of it. He speaks for Kessat this season and wants the trade to come up the river." },
        { "id": "person.kuusit", "name": "Kuusit", "role": "keeper of the hill", "about": "Old, of the lineage that keeps the hill. Says little to strangers and nothing about the hill." },
        { "id": "person.teskaat", "name": "Teskaat", "role": "a trader of Kessat", "about": "Knows a little Brennish and a good deal of the lagoon's trade tongue; comes quietly, and counts everything twice." }
      ],
      "wants": { "item.trade_cloth": 10, "item.sailcloth": 8, "item.axe": 8, "item.trade_knives": 5, "item.wine": 4, "item.fishhooks": 2 },
      "offers": { "item.maize": 1, "item.smoked_meat": 1.5, "item.fruit": 0.8 }
    }
  ],
  // What the peoples know and will tell, to those they trust enough, through an interpreter good enough.
  "knowledge": [
    { "id": "know.ground", "name": "whose ground it is", "from": ["people.mahenu", "people.oruwai"], "trust": -5, "language": 1,
      "text": "The headland and the lagoon's mouth are the fishing grounds of Oruwai's households; the shore by the weirs, Mahenu's. The factory was built on Oruwai's ground. No one asked." },
    { "id": "know.roots", "name": "their roots and grain", "from": ["people.mahenu", "people.oruwai"], "trust": 12, "language": 1,
      "text": "Cassava from cuttings, and maize from seed, in ground burned and hoed; they grow here as nothing from the seed chest will.",
      "gives": { "item.cassava_cuttings": 4, "item.seed_maize": 4 } },
    { "id": "know.bitter_cassava", "name": "how to make bitter cassava safe", "from": ["people.mahenu"], "trust": 25, "language": 2,
      "text": "The roots are grated, the juice pressed out in a woven tube, the meal dried and baked. Eaten raw, they sicken and can kill." },
    { "id": "know.fever_lore", "name": "how they keep off the fever", "from": ["people.mahenu"], "trust": 18, "language": 2,
      "text": "Sleep up off the ground, in hammocks, in smoke, away from standing water; and not on the low ground in the wet." },
    { "id": "know.storm", "name": "the storm at the change of season", "from": ["people.oruwai", "people.mahenu"], "trust": 10, "language": 2,
      "text": "When the wet comes in, a great wind comes with it, about the tenth day: they tie down their roofs and draw up the canoes." },
    { "id": "know.route_dyewood", "name": "the way to the dye-wood", "from": ["people.oruwai", "people.mahenu"], "trust": 10, "language": 1,
      "text": "The red wood grows behind Oruwai, half a day into the forest; by the lagoon's edge from the fishing camp, then the trail.",
      "reveals": ["place.fishing_camp", "place.oruwai", "place.dyewood"] },
    { "id": "know.route_kessat", "name": "the way up the river", "from": ["people.tesiwa", "people.mahenu"], "trust": 5, "language": 1,
      "text": "Up the Río Bermejo to the canoe landing, a day and a half, and then a day's walk up the valley to Kessat. From Oruwai there is a forest trail.",
      "reveals": ["place.tesiwa_landing", "place.kessat"] },
    { "id": "know.brennish", "name": "who trades with whom", "from": ["people.tesiwa", "people.mahenu"], "trust": 25, "language": 2,
      "text": "The Brennish ships put in at a cove beyond the salt pans and trade iron to Kessat for salt, food and wood the Tesiwa do not own.",
      "reveals": ["place.salt_pans", "place.brennish_cove"] },
    { "id": "know.garrison_tesiwa", "name": "Kessat's tale of the factory", "from": ["people.tesiwa"], "trust": 12, "language": 1,
      "text": "Sattek laughs. The lagoon people burned the foreigners' house, he says, and it was Kessat's Brennish iron that cut its gate." },
    { "id": "know.garrison_oruwai", "name": "Oruwai's tale of the factory", "from": ["people.oruwai"], "trust": 25, "language": 2,
      "text": "Hiruwe speaks flatly. The foreigners came to the fishing camp in the second wet and took six of their people, to make Oruwai cut wood for them. Oruwai cut no wood. Oruwai burned their house. Four of the six came home." },
    { "id": "know.garrison_mahenu", "name": "what happened to the garrison", "from": ["people.mahenu"], "trust": 42, "language": 3,
      "text": "Narehwa tells it all, slowly. The garrison's commander took Oruwai's people for wood; Oruwai and men of Kessat burned the factory; most of the garrison died at the gate. Two ran to Mahenu, and Mahenu would not give them up, though Oruwai still holds it against them. One died of the fever. The other, Gaspar Lezo, lives at Mahenu still, and will speak to you if you come." }
  ],
