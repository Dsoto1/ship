  {
   "id": "person.anselmo",
   "conversation": {"first": "The old priest is sweeping his own chapel step. \"Captain. Come to ask God's blessing on the Garza, or on yourself? Either is welcome; both is better.\"", "again": "\"Captain.\" Father Anselmo leans on his broom.", "topics": [{"id": "topic.anselmo.pascual", "ask": "Do you know young Pascual Mena?", "says": "\"Since he was baptised. He has never been further than the river mouth, God keep him, whatever he says to you. He works hard. His mother will break her heart.\"", "leads": ["lead.anselmo_pascual"], "trust": 2, "about": "person.pascual", "tells": ["fact.pascual_never_sailed"]}, {"id": "topic.anselmo.bartolo", "ask": "And Bartolo, the old carpenter?", "says": "\"We have argued every Sunday for thirty years. He is the best man in this parish and he will die at sea if you take him, and he would rather that than die in his bed.\" He looks at you. \"Take him, if he wants to go.\"", "affection": 3}, {"id": "topic.anselmo.coast", "ask": "Have the Company ships come back, Father?", "says": "\"Some. I have buried the names of more than came back. I keep a list, Captain; I would be glad not to add your crew to it.\"", "trust": 3}]},
   "greetings": [{"standing": 1, "text": "\"Go with God, Captain. Bring them back, if you can.\""}, {"standing": 3, "text": "\"I will say a Mass for the Garza on the morning she sails.\""}],
