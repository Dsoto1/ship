  {
   "id": "person.mateo",
   "conversation": {"first": "The guard leans on his halberd. \"Captain. Come to look at our convict?\"", "again": "Mateo yawns. \"Captain.\"", "topics": [{"id": "topic.mateo.tome", "ask": "What do you know of Tomé?", "says": "\"Took up for a knifing on the waterfront. Some say he was a sailor once, on a ship that came home without her master.\" He shrugs. \"Quiet enough in the cells. Eats like two men.\"", "leads": ["lead.mateo_tome"], "trust": 1, "about": "person.tome", "tells": ["fact.tome_sailor"]}, {"id": "topic.mateo.hob", "ask": "Anything I should know about on this quay?", "says": "\"The Brennish trader, Hob. Sells cheap and his water goes green in a week. And Gil the cooper, if you want casks that hold.\"", "leads": ["lead.mateo_hob", "lead.mateo_gil"], "trust": 1}]},
