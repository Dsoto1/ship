  {
   "id": "person.pascual",
   "facts": [{"id": "fact.pascual_never_sailed", "text": "Has never been past the river bar, say Inés and Father Anselmo, whatever he claims."}],
   "conversation": {"first": "The young man jumps up so fast he nearly drops his bundle. \"Captain! Pascual Mena, sir. I've been waiting all morning. I'm ready to sail today.\"", "again": "\"Captain!\" Pascual is already on his feet.", "topics": [{"id": "topic.pascual.coasting", "ask": "Tell me about the coasting trade.", "says": "\"Two years, up and down to Lusara! Sailing, rigging, anything you like.\" When you ask him the name of the ship, he says the San Telmo; when you ask her master, he says Don... he can't remember.", "claims": {"skill.sailing": 3, "skill.rigging": 2}}, {"id": "topic.pascual.truth", "ask": "Father Anselmo says you've never been past the bar.", "known": ["fact.pascual_never_sailed"], "says": "His face goes red to the ears. \"I've been on the river boats. And I watch them every day, Captain, I know every rope, I could name them for you. I want it more than anyone on this quay. I'm sorry I lied.\"", "claims": {"skill.sailing": 1, "skill.rigging": 1}, "trust": 6, "affection": 6}, {"id": "topic.pascual.mother", "ask": "What does your mother say?", "after": ["topic.pascual.coasting"], "says": "\"She sells candles by the chapel.\" He looks at his feet. \"She says my father went on the Company ships and didn't come back, and she'll not lose me the same way. She doesn't know I'm here.\"", "affection": 4, "trust": 3}, {"id": "topic.pascual.terms", "ask": "What would you want?", "seeking": true, "terms": true, "after": ["topic.pascual.coasting"], "says": "\"Five hundred? Or less. Whatever's fair, Captain. I'd go for nothing.\""}]},
