  {
   "id": "person.ximena",
   "song": {"voice": "cradle", "title": "A cradle song from Mahenu", "says": "Ximena does not stand. She sings sitting, her hand on the shell at her throat, a soft rising song in a tongue no one here speaks, and her voice breaks once in the middle. No one claps. Then Gil does, and everyone else.", "lines": ["Naku te, naku te, the water is warm,", "the lagoon holds you, the reef holds the storm..."], "shows": {"language.ahuneri": 4}},
   "facts": [{"id": "fact.ximena_season", "text": "Was at Mahenu a season, not a year, and left in a hurry, says Hernando."}, {"id": "fact.ximena_child", "text": "Had a child at Mahenu, and left him with his father's people when the Company ship came."}],
   "conversation": {"first": "The fish seller keeps gutting while you talk; her knife does not stop. \"You're the Garza. Everyone knows. Are you buying, or asking?\"", "again": "Ximena flicks the scales off her knife. \"Asking again, Captain?\"", "topics": [{"id": "topic.ximena.mahenu", "ask": "You lived among the Ahuneri?", "says": "\"At Mahenu, on the lagoon, after the Rosario broke up on the bar. Three of us came ashore. Two of us lived.\" She speaks a few words, low and quick, in a tongue you do not know. \"That means 'the sea took the rest'. You'll want to know how to say that.\"", "claims": {"language.ahuneri": 4, "skill.languages": 3}, "trust": 4}, {"id": "topic.ximena.shell", "ask": "The shell on the thong?", "after": ["topic.ximena.mahenu"], "says": "Her hand goes to it. \"A gift.\" That is all she says, and her knife is still for a moment.", "guard": {"trust": 6, "says": "\"A shell.\" The knife goes back to work.", "change": -1}, "trust": 3}, {"id": "topic.ximena.season", "ask": "Hernando says it was a season, not a year.", "known": ["fact.ximena_season"], "says": "She puts the knife down. \"It was fourteen months. Hernando came on the Company ship at the end of it and saw a woman run down the beach to it, so he thinks he knows.\" Quietly: \"I had a son there. His father's people kept him when I went. I did not run to the ship, Captain; I ran from them telling me to go.\"", "guard": {"trust": 12, "says": "\"Hernando was drunk the whole time he was on that coast.\" She goes on gutting, harder.", "change": -5}, "tells": ["fact.ximena_child"], "trust": 8, "affection": 6}, {"id": "topic.ximena.why", "ask": "Why go back?", "after": ["topic.ximena.mahenu"], "says": "\"For the fish, Captain.\" She does not smile. \"You'll need someone who can talk to them before your soldiers do. That's reason enough for you.\"", "trust": 2}, {"id": "topic.ximena.terms", "ask": "What would you want?", "seeking": true, "terms": true, "after": ["topic.ximena.mahenu"], "says": "\"Twelve hundred. And that I go ashore at Mahenu, whatever else you do there.\""}]},
