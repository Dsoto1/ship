   "seeking": {
   "trust": 10, "notYet": "\"I sail with masters I know, Captain. I do not know you yet.\"",
    "asks": 1600,
    "lowest": 1600,
    "pitch": "\"I have taken ships to the Ember Coast three times. I know the shoals off the river mouths and the currents in the dry season. Why go back? That is my business, Captain.\"",
    "claims": {
