  {
   "id": "person.gil",
   "song": {"voice": "chorus", "title": "The Cooper's Round", "says": "Gil rolls an empty cask into the middle of the room and drums the time on it with his fists. It is a round, and he gets the whole room singing it in three parts before it falls apart in laughter.", "lines": ["Hoop it and drive it and drive it and hoop it,", "a cask that is tight is a cask that won't droop it!"]},
   "conversation": {"first": "The cooper stops a cask with his foot without looking at it. \"Captain! Water, is it? Or a man to keep it?\"", "again": "Gil raps a stave with his knuckle out of habit. \"Captain.\"", "topics": [{"id": "topic.gil.casks", "ask": "What makes a good cask?", "says": "\"Oak, seasoned three years, and a cooper who isn't in a hurry. Listen.\" He thumps one: it rings. Another: it thuds. \"That one leaks. I'll not sell it you. Hob would.\"", "claims": {"skill.carpentry": 3, "skill.ship_repair": 2}, "trust": 4, "respect": 3}, {"id": "topic.gil.family", "ask": "You've a family?", "after": ["topic.gil.casks"], "says": "\"Wife and four, and one coming. That's why I want the voyage, Captain: a share on the coast is two years of casks.\" He grins. \"And it's quieter at sea.\"", "affection": 5, "trust": 3}, {"id": "topic.gil.terms", "ask": "What would you want?", "seeking": true, "terms": true, "after": ["topic.gil.casks"], "says": "\"Nine hundred, and half of it to my wife at the door, not to me at the tavern.\""}]},
