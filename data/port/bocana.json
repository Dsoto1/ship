  "greetings": [
   {
    "standing": 1,
    "text": "\"Captain.\" A nod, and a look at you as you pass."
   },
   {
    "standing": 1,
    "text": "\"That's the Garza's man,\" you hear behind you."
   },
   {
    "standing": 2,
    "text": "\"Signed on {crew} already, they say. Where is it you're bound, Captain?\""
   },
   {
    "standing": 2,
    "text": "\"God keep you and the Garza, Captain.\""
   },
   {
    "standing": 3,
    "text": "\"Captain! Sailing with the convoy? {hours} hours, is it?\""
   },
   {
    "standing": 3,
    "text": "\"There goes the Ember Coast captain.\" Someone laughs, not unkindly."
   }
  ]
 },
